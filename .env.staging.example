# ==============================================================================
# MivaFid - Configuration Environnement Staging (Laravel Cloud)
# ==============================================================================
# Note : Sur Laravel Cloud, lorsque vous attachez les services managés
# (PostgreSQL, Redis, Reverb), leurs variables de connexion respectives sont
# souvent auto-injectées par la plateforme. Les variables ci-dessous sont
# celles à définir ou vérifier dans l'onglet "Environment Variables".
# ==============================================================================

APP_NAME="MivaFid (Staging)"
APP_ENV=staging
APP_KEY=
APP_DEBUG=true
APP_URL=https://votre-app-staging.laravel.cloud

APP_LOCALE=fr
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=debug

# ── Base de données (PostgreSQL Managé sur Laravel Cloud) ──────────────────────
DB_CONNECTION=pgsql
# DB_HOST, DB_PORT, DB_DATABASE, DB_USERNAME, DB_PASSWORD sont
# généralement auto-remplis par Laravel Cloud si la DB est liée à l'environnement.

# ── Files d'attente, Cache & Sessions (Redis Managé) ─────────────────────────
QUEUE_CONNECTION=redis
CACHE_STORE=redis
SESSION_DRIVER=database

REDIS_CLIENT=phpredis
# REDIS_HOST, REDIS_PORT, REDIS_PASSWORD sont auto-injectés par Laravel Cloud.

# ── Temps Réel (Laravel Reverb Managé sur Laravel Cloud) ──────────────────────
BROADCAST_CONNECTION=reverb

# Si vous liez le cluster Reverb géré par Laravel Cloud, ces variables
# sont auto-injectées. Côté client mobile Flutter (Miva_Fid), ReverbConfig.appKey
# utilise 'lmr8oqvyjygvcbcujywu' par défaut.
REVERB_APP_ID=
REVERB_APP_KEY=lmr8oqvyjygvcbcujywu
REVERB_APP_SECRET=
REVERB_HOST=votre-app-staging.laravel.cloud
REVERB_PORT=443
REVERB_SCHEME=https

# ── Firebase (FCM & OAuth) ────────────────────────────────────────────────────
FIREBASE_PROJECT_ID=mivafid-app
# Coller le contenu JSON en une seule ligne OU en base64 de service-account.json :
FIREBASE_CREDENTIALS_JSON=
FIREBASE_TOKEN_LEEWAY=60

# ── OAuth ────────────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
APPLE_CLIENT_ID=com.mivafid.app

# ── Paiement FedaPay (Sandbox) ────────────────────────────────────────────────
FEDAPAY_SECRET_KEY=
FEDAPAY_PUBLIC_KEY=
FEDAPAY_ENVIRONMENT=sandbox
FEDAPAY_WEBHOOK_SECRET=

# ── OTP & Notifications (SMS / WhatsApp / Email) ──────────────────────────────
# Mailer : 'log' pour simuler ou 'resend' en test réel
MAIL_MAILER=log
RESEND_API_KEY=

# Zavu.dev (SMS / WhatsApp)
ZAVU_API_KEY=
ZAVU_SENDER_ID=
ZAVU_WHATSAPP_TEMPLATE=otp_verification
ZAVU_FROM_EMAIL=no-reply@mivafid.com
ZAVU_FORCE_DELIVERY=false

# Africa's Talking (repli SMS)
AFRICASTALKING_USERNAME=sandbox
AFRICASTALKING_API_KEY=
AFRICASTALKING_SENDER_ID=

# 360dialog (WhatsApp direct)
DIALOG360_API_KEY=
DIALOG360_OTP_TEMPLATE=otp_verification
DIALOG360_TEMPLATE_LANG=fr

# Campagnes SMS : false pour permettre les tests hors fenêtre 8h-20h
CAMPAIGN_SEND_WINDOW_ENABLED=false
