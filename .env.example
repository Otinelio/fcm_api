APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=restaurant_loyalty
DB_USERNAME=loyalty_user
DB_PASSWORD=loyalty_secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Envoi OTP (mot de passe oublié) — voir App\Services\Otp\OtpDeliveryService.
# Local/dev : laisser vide, APP_DEBUG=true suffit (code renvoyé via debug_otp,
# aucun appel réseau réel). En production : MAIL_MAILER=resend + RESEND_API_KEY.
RESEND_API_KEY=

# Platforme unifiée Zavu.dev (SMS, WhatsApp, Email) — https://zavu.dev
ZAVU_API_KEY=
ZAVU_SENDER_ID=
ZAVU_WHATSAPP_TEMPLATE=otp_verification
ZAVU_FROM_EMAIL=no-reply@mivafid.com

# SMS (repli si WhatsApp échoue) — https://africastalking.com
AFRICASTALKING_USERNAME=
AFRICASTALKING_API_KEY=
AFRICASTALKING_SENDER_ID=

# WhatsApp (canal prioritaire pour un numéro) — https://www.360dialog.com
DIALOG360_API_KEY=
DIALOG360_OTP_TEMPLATE=otp_verification
DIALOG360_TEMPLATE_LANG=fr

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

FEDAPAY_SECRET_KEY=
FEDAPAY_PUBLIC_KEY=
FEDAPAY_ENVIRONMENT=sandbox
FEDAPAY_WEBHOOK_SECRET=

# Firebase — validation serveur des id_token Google (SocialAuthService) et
# envoi FCM. Le fichier de compte de service n'est pas versionné : le déposer
# dans storage/app/firebase/service-account.json.
FIREBASE_PROJECT_ID=mivafid-1bc6a
FIREBASE_CREDENTIALS=storage/app/firebase/service-account.json

# OAuth — audiences vérifiées côté serveur lors de POST /auth/social.
GOOGLE_CLIENT_ID=
APPLE_CLIENT_ID=com.mivafid.app

# Reverb — diffusion temps réel des récompenses débloquées.
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"
